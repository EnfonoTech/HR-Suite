 "html": "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"UTF-8\">\n<style>\n  body {\n    font-family: 'Arial', 'Tahoma', sans-serif;\n    font-size: 13px;\n    color: #1a1a1a;\n    margin: 0;\n    padding: 40px 50px;\n    background: #fff;\n  }\n  .letterhead {\n    text-align: center;\n    border-bottom: 3px double #1a5276;\n    padding-bottom: 18px;\n    margin-bottom: 28px;\n  }\n  .letterhead .company-name {\n    font-size: 22px;\n    font-weight: bold;\n    color: #1a5276;\n    margin-bottom: 4px;\n  }\n  .letterhead .doc-title {\n    font-size: 15px;\n    color: #555;\n    letter-spacing: 1px;\n    text-transform: uppercase;\n  }\n  .meta-row {\n    display: flex;\n    justify-content: space-between;\n    margin-bottom: 24px;\n    font-size: 12px;\n    color: #555;\n  }\n  .ref-no { font-weight: bold; color: #1a5276; }\n  .to-whom {\n    background: #f4f6f8;\n    border-right: 4px solid #1a5276;\n    padding: 10px 16px;\n    margin-bottom: 24px;\n    font-size: 13px;\n    line-height: 1.8;\n  }\n  .letter-body {\n    line-height: 1.9;\n    margin-bottom: 30px;\n    font-size: 13px;\n  }\n  .employee-info {\n    background: #f0f4f8;\n    padding: 14px 18px;\n    margin: 20px 0;\n    border-radius: 4px;\n  }\n  .employee-info table {\n    width: 100%;\n    border-collapse: collapse;\n  }\n  .employee-info td {\n    padding: 5px 10px;\n    vertical-align: top;\n  }\n  .employee-info td:first-child {\n    font-weight: bold;\n    width: 180px;\n    color: #2c3e50;\n  }\n  .signature-section {\n    margin-top: 60px;\n    display: flex;\n    justify-content: space-between;\n  }\n  .sig-box {\n    text-align: center;\n    min-width: 180px;\n  }\n  .sig-line {\n    border-top: 1px solid #333;\n    margin-top: 55px;\n    padding-top: 8px;\n    font-size: 12px;\n    color: #444;\n  }\n  .validity-notice {\n    margin-top: 40px;\n    text-align: center;\n    font-size: 11px;\n    color: #888;\n    border-top: 1px dashed #ccc;\n    padding-top: 12px;\n  }\n  .footer {\n    text-align: center;\n    margin-top: 20px;\n    font-size: 10px;\n    color: #bbb;\n    border-top: 1px solid #eee;\n    padding-top: 10px;\n  }\n</style>\n</head>\n<body>\n\n<div class=\"letterhead\">\n  <div class=\"company-name\">{{ doc.company }}</div>\n  <div class=\"doc-title\">HR Letter</div>\n</div>\n\n<div class=\"meta-row\">\n  <span class=\"ref-no\">Ref: {{ doc.name }}</span>\n  <span>Date: {{ frappe.format(doc.posting_date, {\"fieldtype\": \"Date\"}) }}</span>\n</div>\n\n{% if doc.purpose %}\n<div class=\"to-whom\">\n  <strong>To Whom It May Concern</strong><br>\n  {{ doc.purpose }}\n</div>\n{% else %}\n<div class=\"to-whom\">\n  <strong>To Whom It May Concern</strong>\n</div>\n{% endif %}\n\n<div class=\"letter-body\">\n  {{ doc.terms | safe }}\n</div>\n\n<div class=\"employee-info\">\n  <table>\n    <tr>\n      <td>Employee Name</td>\n      <td>{{ doc.employee_name }}</td>\n      <td>Designation</td>\n      <td>{{ doc.designation or '' }}</td>\n    </tr>\n    <tr>\n      <td>Department</td>\n      <td>{{ doc.department or '' }}</td>\n      <td>Date of Joining</td>\n      <td>{{ frappe.format(doc.joining_date, {\"fieldtype\": \"Date\"}) if doc.joining_date else '' }}</td>\n    </tr>\n    {% if doc.nationality %}\n    <tr>\n      <td>Nationality</td>\n      <td colspan=\"3\">{{ doc.nationality }}</td>\n    </tr>\n    {% endif %}\n  </table>\n</div>\n\n<div class=\"signature-section\">\n  <div class=\"sig-box\">\n    <div class=\"sig-line\">Employee Signature<br>{{ doc.employee_name }}</div>\n  </div>\n  <div class=\"sig-box\">\n    <div class=\"sig-line\">HR Manager<br>{{ doc.hr_manager_name or doc.hr_manager or '' }}</div>\n  </div>\n</div>\n\n<div class=\"validity-notice\">\n  This letter is valid for 3 months from the issue date.\n</div>\n\n<div class=\"footer\">\n  {{ doc.company }} &mdash; Issued on {{ frappe.format(doc.posting_date, {\"fieldtype\": \"Date\"}) }}\n</div>\n\n</body>\n</html>",
