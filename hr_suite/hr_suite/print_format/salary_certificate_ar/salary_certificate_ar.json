 "font_size": 14,
 "html": "<!DOCTYPE html>\n<html dir=\"rtl\" lang=\"ar\">\n<head>\n<meta charset=\"UTF-8\">\n<style>\n  body {\n    font-family: 'Arial', 'Tahoma', 'DejaVu Sans', sans-serif;\n    direction: rtl;\n    font-size: 13px;\n    color: #1a1a1a;\n    margin: 0;\n    padding: 30px 40px;\n    background: #fff;\n  }\n  .header {\n    text-align: center;\n    border-bottom: 3px double #1a5276;\n    padding-bottom: 18px;\n    margin-bottom: 25px;\n  }\n  .company-logo {\n    max-height: 70px;\n    margin-bottom: 8px;\n  }\n  .header h1 {\n    font-size: 24px;\n    color: #1a5276;\n    margin: 6px 0 2px 0;\n    letter-spacing: 1px;\n  }\n  .header h2 {\n    font-size: 14px;\n    color: #555;\n    font-weight: normal;\n    margin: 0;\n  }\n  .cert-number {\n    font-size: 11px;\n    color: #888;\n    margin-top: 6px;\n  }\n  .issue-date {\n    text-align: left;\n    font-size: 12px;\n    color: #555;\n    margin-bottom: 20px;\n  }\n  .to-whom {\n    background: #eaf2f8;\n    border-right: 5px solid #1a5276;\n    padding: 12px 18px;\n    margin: 20px 0;\n    font-size: 13px;\n    line-height: 2;\n    border-radius: 0 4px 4px 0;\n  }\n  .section-title {\n    background: #1a5276;\n    color: white;\n    padding: 7px 16px;\n    font-size: 14px;\n    border-radius: 3px;\n    margin: 22px 0 10px 0;\n    font-weight: bold;\n  }\n  table.info {\n    width: 100%;\n    border-collapse: collapse;\n    margin-bottom: 10px;\n  }\n  table.info td {\n    padding: 8px 12px;\n    border-bottom: 1px solid #e8e8e8;\n    vertical-align: top;\n  }\n  table.info td:first-child {\n    font-weight: bold;\n    width: 200px;\n    color: #2c3e50;\n    background: #f7fbff;\n  }\n  table.salary {\n    width: 100%;\n    border-collapse: collapse;\n    margin: 10px 0 20px 0;\n  }\n  table.salary th {\n    background: #1a5276;\n    color: white;\n    padding: 9px 12px;\n    text-align: right;\n    font-size: 13px;\n  }\n  table.salary td {\n    padding: 8px 12px;\n    border-bottom: 1px solid #e0e0e0;\n    text-align: right;\n  }\n  table.salary tr:nth-child(even) td {\n    background: #f5f9fd;\n  }\n  .gross-row td {\n    font-weight: bold;\n    background: #d6eaf8 !important;\n    border-top: 2px solid #1a5276;\n    font-size: 14px;\n  }\n  .amount-highlight {\n    text-align: center;\n    background: #d6eaf8;\n    border: 2px solid #1a5276;\n    border-radius: 6px;\n    padding: 14px;\n    font-size: 18px;\n    font-weight: bold;\n    color: #1a5276;\n    margin: 15px 0;\n  }\n  .purpose-box {\n    background: #fef9e7;\n    border: 1px solid #f0c040;\n    border-radius: 4px;\n    padding: 12px 18px;\n    font-size: 12px;\n    color: #7d6608;\n    margin: 15px 0;\n  }\n  .validity-box {\n    background: #fdf2f8;\n    border: 1px solid #c39bd3;\n    border-radius: 4px;\n    padding: 10px 16px;\n    font-size: 12px;\n    color: #6c3483;\n    margin: 10px 0;\n    text-align: center;\n  }\n  .signature-section {\n    margin-top: 55px;\n    display: flex;\n    justify-content: space-between;\n    gap: 40px;\n  }\n  .sig-box {\n    flex: 1;\n    text-align: center;\n  }\n  .sig-line {\n    border-top: 1px solid #333;\n    margin-top: 55px;\n    padding-top: 8px;\n    font-size: 12px;\n    color: #444;\n  }\n  .footer {\n    text-align: center;\n    margin-top: 40px;\n    font-size: 10px;\n    color: #aaa;\n    border-top: 1px solid #ddd;\n    padding-top: 12px;\n  }\n  .stamp-area {\n    text-align: center;\n    margin-top: 20px;\n    border: 2px dashed #ccc;\n    padding: 20px;\n    color: #aaa;\n    font-size: 12px;\n    border-radius: 50%;\n    width: 100px;\n    height: 100px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    margin-left: 20px;\n  }\n</style>\n</head>\n<body>\n\n{%- set company = doc.company -%}\n{%- set issue_date = frappe.utils.today() -%}\n{%- set validity_date = frappe.utils.add_months(issue_date, 3) -%}\n{%- set contract = frappe.db.get_value(\n  \"Country Employment Contract\",\n  {\"employee\": doc.name, \"contract_status\": \"Active\"},\n  [\"basic_salary\", \"housing_allowance\", \"transport_allowance\", \"other_allowances\", \"total_salary\", \"currency\"],\n  as_dict=True,\n) or {} -%}\n{%- set currency = contract.get(\"currency\") or frappe.db.get_value(\"Company\", company, \"default_currency\") -%}\n\n<div class=\"header\">\n  <h1>شهادة راتب / Salary Certificate</h1>\n  <h2>{{ company }}</h2>\n</div>\n\n<div class=\"cert-number\">{{ _(\"Certificate No\") }}: {{ doc.name }}</div>\n<div class=\"issue-date\">{{ _(\"Issue Date\") }}: {{ frappe.utils.formatdate(issue_date) }}</div>\n\n<div class=\"to-whom\">إلى من يهمه الأمر / To Whom It May Concern</div>\n\n<div class=\"info\">\n  <div class=\"section-title\">{{ _(\"Employee Details\") }}</div>\n  <table>\n    <tr><td>{{ _(\"Employee Name\") }} / الاسم</td><td>{{ doc.employee_name }}</td></tr>\n    <tr><td>{{ _(\"Employee ID\") }} / الرقم الوظيفي</td><td>{{ doc.name }}</td></tr>\n    <tr><td>{{ _(\"Designation\") }} / المسمى الوظيفي</td><td>{{ doc.designation or \"\" }}</td></tr>\n    <tr><td>{{ _(\"Date of Joining\") }} / تاريخ التعيين</td><td>{{ frappe.utils.formatdate(doc.date_of_joining) }}</td></tr>\n  </table>\n</div>\n\n<div class=\"salary\">\n  <div class=\"section-title\">{{ _(\"Salary Details\") }} / تفاصيل الراتب</div>\n  <table>\n    <tr><td>{{ _(\"Basic Salary\") }} / الراتب الأساسي</td><td>{{ frappe.utils.fmt_money(contract.get(\"basic_salary\") or 0, currency=currency) }}</td></tr>\n    <tr><td>{{ _(\"Housing Allowance\") }} / بدل السكن</td><td>{{ frappe.utils.fmt_money(contract.get(\"housing_allowance\") or 0, currency=currency) }}</td></tr>\n    <tr><td>{{ _(\"Transport Allowance\") }} / بدل النقل</td><td>{{ frappe.utils.fmt_money(contract.get(\"transport_allowance\") or 0, currency=currency) }}</td></tr>\n    <tr><td>{{ _(\"Other Allowances\") }} / بدلات أخرى</td><td>{{ frappe.utils.fmt_money(contract.get(\"other_allowances\") or 0, currency=currency) }}</td></tr>\n  </table>\n  <div class=\"amount-highlight\">\n    {{ _(\"Total Salary\") }} / إجمالي الراتب:\n    {{ frappe.utils.fmt_money(contract.get(\"total_salary\") or 0, currency=currency) }}\n  </div>\n</div>\n\n<div class=\"purpose-box\">\n  {{ _(\"This certificate is issued at the employee's request and does not constitute a financial obligation on the employer.\") }}<br>\n  تُصدر هذه الشهادة بناءً على طلب الموظف ولا تُعد التزامًا ماليًا على صاحب العمل.\n</div>\n\n<div class=\"validity-box\">\n  {{ _(\"Valid until\") }} / صالحة حتى: {{ frappe.utils.formatdate(validity_date) }}\n</div>\n\n<div class=\"signature-section\">\n  <div class=\"sig-box\">\n    <div class=\"sig-line\"></div>\n    {{ _(\"Human Resources\") }} / الموارد البشرية\n  </div>\n  <div class=\"stamp-area\">{{ _(\"Company Stamp\") }}<br>ختم الشركة</div>\n</div>\n\n<div class=\"footer\">{{ company }}</div>\n\n</body>\n</html>\n",
