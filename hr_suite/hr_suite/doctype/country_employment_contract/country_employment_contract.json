  {"fieldname": "total_salary", "fieldtype": "Currency", "label": "Total Salary", "read_only": 1},
  {"fieldname": "currency", "fieldtype": "Link", "label": "Currency", "options": "Currency"},
  {"fieldname": "working_hours_section", "fieldtype": "Section Break", "label": "Working Hours"},
  {"fieldname": "working_hours_per_day", "fieldtype": "Float", "label": "Working Hours/Day", "default": "8"},
  {"fieldname": "weekly_working_days", "fieldtype": "Int", "label": "Working Days/Week", "default": "5"},
  {"fieldname": "column_break_5", "fieldtype": "Column Break"},
  {"fieldname": "weekly_rest_day", "fieldtype": "Select", "label": "Weekly Rest Day", "options": "Friday\nSaturday\nSunday\nFriday-Saturday"},
  {"fieldname": "outdoor_work_restriction", "fieldtype": "Check", "label": "Outdoor Work Restriction Applies"},
  {"fieldname": "permit_section", "fieldtype": "Section Break", "label": "Work Permit & Identity"},
  {"fieldname": "nationality", "fieldtype": "Data", "label": "Nationality"},
