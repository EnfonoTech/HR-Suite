  {"role": "HR Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "submit": 1, "cancel": 1, "amend": 1},
  {"role": "HR User", "read": 1, "write": 1, "create": 1}
 ],
 "sort_field": "modified",
 "sort_order": "DESC"
}
