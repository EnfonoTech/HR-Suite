  {"fieldname": "permit_number", "fieldtype": "Data", "label": "Permit Number"},
  {"fieldname": "column_break_6", "fieldtype": "Column Break"},
  {"fieldname": "permit_expiry_date", "fieldtype": "Date", "label": "Permit Expiry Date"},
  {"fieldname": "passport_number", "fieldtype": "Data", "label": "Passport Number"},
  {"fieldname": "visa_type", "fieldtype": "Data", "label": "Visa / Entry Type"},
  {"fieldname": "notes_section", "fieldtype": "Section Break", "label": "Terms & Conditions"},
