  {
   "fieldname": "loan_salary_component",
   "fieldtype": "Link",
   "label": "Loan Repayment Salary Component",
   "options": "Salary Component",
   "description": "Deduction component that carries an Employee Loan instalment onto the Salary Slip. Leave blank to use 'Loan Repayment', which HR Suite creates on first use - but only once it can map an account for the company."
  },
  {
   "fieldname": "statutory_accounts_section",
   "fieldtype": "Section Break",
   "label": "Deduction Accounts"
  },
  {
   "fieldname": "statutory_accounts_help",
   "fieldtype": "HTML",
   "options": "<p class=\"text-muted\" style=\"font-size:0.85rem;\">HR Suite posts three kinds of deduction onto the Salary Slip: the country statutory contribution (GOSI / GPSSA / SIO / PASI / EPF / ESI), an <b>Employee Loan</b> instalment and an <b>Employee Penalty</b>. A Salary Component that has no <b>Salary Component Account</b> for the company makes Payroll Entry’s accrual Journal Entry fail, which rolls the whole payroll run back. Map the accounts here: a row with no Salary Component is the default for the company, a row naming one overrides it for that component. Without a mapping HR Suite refuses to post the deduction instead of breaking payroll, and says so on Payroll Preview.</p>"
  },
  {
   "fieldname": "statutory_deduction_accounts",
