  {
   "fieldname": "column_break_4",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "salary_days_due",
   "fieldtype": "Float",
   "label": "Leave Days Not Yet Paid",
   "read_only": 1,
   "precision": "2",
   "description": "Leave days of this application not covered by an earlier settlement."
  },
  {
   "fieldname": "salary_days_paid",
   "fieldtype": "Float",
   "label": "Salary Days Paid Now",
   "read_only": 1,
   "precision": "2"
  },
  {
   "fieldname": "salary_days_unpaid",
   "fieldtype": "Float",
   "label": "Salary Days Still Due",
   "read_only": 1,
   "precision": "2",
   "description": "Earned later; released by a further settlement."
  },
  {
   "fieldname": "leave_salary_amount",
   "fieldtype": "Currency",
   "label": "Leave Salary",
   "read_only": 1,
   "precision": "3"
  },
  {
   "fieldname": "ticket_section",
   "fieldtype": "Section Break",
   "label": "Air Ticket"
