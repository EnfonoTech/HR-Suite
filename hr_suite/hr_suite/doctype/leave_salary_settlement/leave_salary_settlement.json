   "fieldname": "pay_worked_days_in_settlement",
   "fieldtype": "Check",
   "label": "Pays Worked Days",
   "read_only": 1,
   "description": "From the country policy. Ticked: this settlement pays the days worked this month and payroll skips the employee for the month."
  },
  {
   "fieldname": "earned_salary_days",
   "fieldtype": "Float",
   "label": "Earned Leave-Salary Days",
   "read_only": 1,
   "precision": "2"
  },
  {
   "fieldname": "min_earned_days",
   "fieldtype": "Float",
   "label": "Minimum Earned Days",
   "read_only": 1,
   "precision": "2"
  },
  {
   "fieldname": "column_break_3",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "service_days",
   "fieldtype": "Int",
   "label": "Service From Joining (Days)",
   "read_only": 1
  },
  {
   "fieldname": "min_service_days",
   "fieldtype": "Int",
   "label": "Minimum Service (Days)",
   "read_only": 1
  },
  {
   "fieldname": "eligible",
   "fieldtype": "Check",
   "label": "Barrier Met",
   "read_only": 1
  },
  {
   "fieldname": "shortfall_note",
   "fieldtype": "Small Text",
   "label": "Shortfall",
   "read_only": 1
  },
  {
   "fieldname": "pay_below_barrier",
   "fieldtype": "Check",
   "label": "Pay Below The Barrier",
   "description": "Only users with the HR Leave Override role. A reason is required."
  },
