   "fieldname": "pay_section",
   "fieldtype": "Section Break",
   "label": "Pay"
  },
  {
   "fieldname": "monthly_gross",
   "fieldtype": "Currency",
   "label": "Monthly Salary (All Earnings)",
   "read_only": 1,
   "precision": "3"
  },
  {
   "fieldname": "days_worked",
   "fieldtype": "Float",
   "label": "Days Worked This Month",
   "read_only": 1,
   "precision": "2"
  },
  {
   "fieldname": "worked_days_pay",
   "fieldtype": "Currency",
   "label": "Worked-Days Salary",
   "read_only": 1,
   "precision": "3"
  },
  {
   "fieldname": "daily_leave_rate",
   "fieldtype": "Currency",
   "label": "Leave-Salary Daily Rate",
   "read_only": 1,
   "precision": "4"
