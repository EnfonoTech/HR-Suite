  {
   "fieldname": "column_break_5",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "extra_days",
   "fieldtype": "Float",
   "label": "Days Over (Late Return)",
   "read_only": 1,
   "allow_on_submit": 1,
   "precision": "2"
  },
  {
   "fieldname": "extension_days_covered",
   "fieldtype": "Float",
   "label": "Covered By Leave Balance",
   "read_only": 1,
   "allow_on_submit": 1,
   "precision": "2"
  },
  {
   "fieldname": "extra_days_unpaid",
   "fieldtype": "Float",
   "label": "Unpaid Days",
   "read_only": 1,
   "allow_on_submit": 1,
   "precision": "2"
  },
  {
   "fieldname": "rejoin_note",
   "fieldtype": "Small Text",
   "label": "Note",
   "read_only": 1,
   "allow_on_submit": 1
  },
  {
   "fieldname": "links_section",
   "fieldtype": "Section Break",
   "label": "Links",
   "collapsible": 1
  },
  {
   "fieldname": "payment_advice_type",
   "fieldtype": "Link",
   "label": "Advice Type",
   "options": "DocType",
   "read_only": 1,
   "allow_on_submit": 1
  },
  {
   "fieldname": "payment_advice",
   "fieldtype": "Dynamic Link",
   "label": "Payment Advice",
   "options": "payment_advice_type",
   "read_only": 1,
   "allow_on_submit": 1
  },
  {
   "fieldname": "exclusion_rows",
   "fieldtype": "Long Text",
   "label": "Payroll Exclusions",
   "hidden": 1,
   "read_only": 1,
   "allow_on_submit": 1
