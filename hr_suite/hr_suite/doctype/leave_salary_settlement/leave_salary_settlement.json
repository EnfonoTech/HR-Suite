  {
   "fieldname": "unused_days",
   "fieldtype": "Float",
   "label": "Unused Leave Days (Early Return)",
   "read_only": 1,
   "allow_on_submit": 1,
   "precision": "2"
  },
  {
   "fieldname": "recovery_amount",
   "fieldtype": "Currency",
   "label": "Leave Salary Recovered",
   "read_only": 1,
   "allow_on_submit": 1,
   "precision": "3"
