  {
   "fieldname": "ticket_entitled",
   "fieldtype": "Check",
   "label": "Ticket Due"
  },
  {
   "fieldname": "ticket_amount",
   "fieldtype": "Currency",
   "label": "Ticket Amount",
   "depends_on": "ticket_entitled",
   "precision": "3"
  },
  {
   "fieldname": "total_section",
   "fieldtype": "Section Break",
   "label": "Payable"
  },
  {
   "fieldname": "pay_lines",
   "fieldtype": "Table",
   "label": "Breakdown",
   "options": "Leave Salary Settlement Line",
   "read_only": 1
  },
  {
   "fieldname": "previously_paid",
   "fieldtype": "Currency",
   "label": "Already Paid (Annual Leave Disbursement)",
   "read_only": 1,
   "precision": "3"
