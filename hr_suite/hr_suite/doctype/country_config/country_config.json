{
 "autoname": "field:country_code",
 "name": "Country Config",
 "module": "Hr Suite",
 "doctype": "DocType",
 "issingle": 0,
 "istable": 0,
 "fields": [
  {"fieldname": "country_code", "fieldtype": "Data", "label": "Country Code", "reqd": 1, "unique": 1, "in_list_view": 1, "description": "ISO 3166-1 alpha-2 code, e.g. SA, AE, BH, IN, OM"},
  {"fieldname": "country_name", "fieldtype": "Data", "label": "Country Name", "reqd": 1, "in_list_view": 1},
  {"fieldname": "column_break_1", "fieldtype": "Column Break"},
  {"fieldname": "currency", "fieldtype": "Link", "label": "Currency", "options": "Currency"},
  {"fieldname": "is_active", "fieldtype": "Check", "label": "Active", "default": "1"},
  {"fieldname": "minimum_wage", "fieldtype": "Currency", "label": "Minimum Wage", "description": "Lowest allowed Base salary for this country. Leave 0 to disable the check."},
  {"fieldname": "statutory_section", "fieldtype": "Section Break", "label": "Statutory Contribution"},
  {"fieldname": "statutory_scheme", "fieldtype": "Select", "label": "Statutory Scheme", "options": "\nGOSI\nGPSSA\nSIO\nPASI\nEPF+ESI\nDEWS\nNone", "in_list_view": 1},
  {"fieldname": "contribution_basis", "fieldtype": "Select", "label": "Contribution Basis", "options": "Basic Salary\nBasic + Housing\nTotal Salary", "default": "Basic Salary"},
  {"fieldname": "contribution_ceiling", "fieldtype": "Currency", "label": "Contribution Ceiling", "description": "Leave 0 for no ceiling"},
  {"fieldname": "column_break_2", "fieldtype": "Column Break"},
  {"fieldname": "expat_employee_rate", "fieldtype": "Percent", "label": "Expatriate Employee Rate (%)"},
  {"fieldname": "expat_employer_rate", "fieldtype": "Percent", "label": "Expatriate Employer Rate (%)"},
  {"fieldname": "national_employee_rate", "fieldtype": "Percent", "label": "National Employee Rate (%)"},
  {"fieldname": "national_employer_rate", "fieldtype": "Percent", "label": "National Employer Rate (%)"},
  {"fieldname": "settlement_section", "fieldtype": "Section Break", "label": "End-of-Service Settlement"},
  {"fieldname": "settlement_formula", "fieldtype": "Select", "label": "Settlement Formula", "options": "\nEOSB-SA\nGratuity-AE\nGratuity-IN\nIndemnity-BH\nIndemnity-OM", "in_list_view": 1},
  {"fieldname": "settlement_basis", "fieldtype": "Select", "label": "Settlement Basis", "options": "Basic Salary\nLast Basic Salary\nAverage Total Salary", "default": "Basic Salary"},
  {"fieldname": "years_threshold", "fieldtype": "Int", "label": "Years Threshold", "default": "5", "description": "Applies to tiered formulas"},
  {"fieldname": "column_break_3", "fieldtype": "Column Break"},
  {"fieldname": "days_per_year_below_threshold", "fieldtype": "Float", "label": "Days/Year (Below Threshold)", "description": "E.g. 15 for SA (0-5 yrs = ½ month)"},
  {"fieldname": "days_per_year_above_threshold", "fieldtype": "Float", "label": "Days/Year (Above Threshold)", "description": "E.g. 30 for SA (5+ yrs = 1 month)"},
  {"fieldname": "gratuity_eligibility_years", "fieldtype": "Float", "label": "Min. Service for Gratuity (Years)", "default": "1", "description": "India: 5 years minimum"},
  {"fieldname": "settlement_ceiling_applicable", "fieldtype": "Check", "label": "Settlement Ceiling Applies"},
  {"fieldname": "settlement_ceiling_amount", "fieldtype": "Currency", "label": "Settlement Ceiling Amount", "depends_on": "eval:doc.settlement_ceiling_applicable"},
  {"fieldname": "leave_section", "fieldtype": "Section Break", "label": "Leave Entitlements"},
  {"fieldname": "leave_types", "fieldtype": "Table", "label": "Leave Types", "options": "Country Leave Type Row"},
  {"fieldname": "permit_section", "fieldtype": "Section Break", "label": "Work Permit & Documents"},
  {"fieldname": "primary_permit_label", "fieldtype": "Data", "label": "Primary Permit Name", "description": "E.g. Iqama, Emirates ID, CPR, Work Permit, ROP Card"},
  {"fieldname": "permit_expiry_alert_days", "fieldtype": "Int", "label": "Expiry Alert (Days Before)", "default": "90"},
  {"fieldname": "column_break_4", "fieldtype": "Column Break"},
  {"fieldname": "national_id_label", "fieldtype": "Data", "label": "National ID Name", "description": "E.g. Muqeem, Emirates ID, CPR, Aadhaar, Civil ID"},
  {"fieldname": "national_id_required", "fieldtype": "Check", "label": "National ID Required"},
  {"fieldname": "recurring_permit_fee_section", "fieldtype": "Section Break", "label": "Recurring Work Permit Fees", "description": "Recurring per-worker government fee for holding a work permit (Bahrain: the LMRA monthly fee). Leave the rate at 0 and the applicability blank until the client has confirmed the figure that applies to them \u2014 HR Suite reports the liability as \"not configured\" rather than assuming one."},
  {"fieldname": "recurring_permit_fee_authority", "fieldtype": "Data", "label": "Fee Authority", "description": "Body that levies the fee, e.g. LMRA in Bahrain. Label only."},
  {"fieldname": "monthly_permit_fee_per_worker", "fieldtype": "Currency", "label": "Monthly Fee per Worker", "options": "currency", "default": "0", "description": "Amount charged per worker per month, in this country's currency. 0 means no rate has been confirmed; it is NOT a statement that the fee is zero."},
  {"fieldname": "column_break_permit_fee", "fieldtype": "Column Break"},
  {"fieldname": "recurring_permit_fee_applies_to", "fieldtype": "Select", "label": "Fee Applies To", "options": "\nExpatriate Employees\nAll Employees", "description": "Who the fee is charged for. Blank means the client has not confirmed the scope, and no liability is calculated."},
  {"fieldname": "recurring_permit_fee_notes", "fieldtype": "Small Text", "label": "Fee Notes", "description": "Exemptions, tiers or reference to the client's own confirmation."},
  {"fieldname": "nationalization_section", "fieldtype": "Section Break", "label": "Nationalisation"},
  {"fieldname": "nationalization_applies", "fieldtype": "Check", "label": "Nationalisation Quota Applies"},
  {"fieldname": "nationalization_scheme_name", "fieldtype": "Data", "label": "Scheme Name", "description": "E.g. Nitaqat (SA), Nafis/Emiratisation (AE), Tanasub (OM)"},
  {"fieldname": "column_break_5", "fieldtype": "Column Break"},
  {"fieldname": "national_job_title", "fieldtype": "Select", "label": "Population Label", "options": "\nSaudi National\nEmirati National\nBahraini National\nOmani National\nIndian National"},
  {"fieldname": "wps_section", "fieldtype": "Section Break", "label": "Wages Protection System"},
  {"fieldname": "wps_mandatory", "fieldtype": "Check", "label": "WPS Mandatory"},
  {"fieldname": "wps_format", "fieldtype": "Select", "label": "WPS File Format", "options": "\nSARIE (SA)\nSIF-AE (UAE)\nWPS-BH (Bahrain)\nWPS-OM (Oman)\nNone"},
  {"fieldname": "column_break_6", "fieldtype": "Column Break"},
  {"fieldname": "notice_period_days_monthly", "fieldtype": "Int", "label": "Notice Period — Monthly Staff (Days)", "default": "30"},
  {"fieldname": "notice_period_days_others", "fieldtype": "Int", "label": "Notice Period — Others (Days)", "default": "30"},
  {"fieldname": "max_probation_days", "fieldtype": "Int", "label": "Max Probation (Days)", "default": "90"}
 ],
 "permissions": [
  {"role": "HR Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
  {"role": "HR User", "read": 1}
 ],
 "sort_field": "country_name",
 "sort_order": "ASC"
}
