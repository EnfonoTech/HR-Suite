  {"fieldname": "period_section", "fieldtype": "Section Break", "label": "Period"},
  {"fieldname": "month", "fieldtype": "Select", "label": "Month", "options": "January\nFebruary\nMarch\nApril\nMay\nJune\nJuly\nAugust\nSeptember\nOctober\nNovember\nDecember", "reqd": 1, "in_list_view": 1},
  {"fieldname": "year", "fieldtype": "Int", "label": "Year", "reqd": 1, "in_list_view": 1},
